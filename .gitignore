.packages
pubspec.lock

# Ignore artifacts generated by "firebase"
.firebase/

# Files generated by dart tools.
**/.dart_tool/
**/doc/api/
**/build/
*.log

.local-chrome/
resources/
# melos
# pubspec_overrides.yaml

# Worktrees temporários de subagentes — nunca versionados.
.claude/

# Capturas de tela do harness do Word (tool/word_reference): artefatos
# LOCAIS de comparação visual manual. São BMPs de vários MB e descrevem a
# máquina de quem rodou — versioná-los engordaria o repositório sem dar
# reprodutibilidade nenhuma. O oráculo versionado é o PDF que o Word exporta
# em resources/word_reference/.
doc/referencias-ui/
